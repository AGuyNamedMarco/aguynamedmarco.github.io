---
import type { ImageMetadata } from "astro";

interface Props {
  size: "large" | "medium" | "small";
  caption: string;
  source?: string;
  image?: {
    asset: ImageMetadata;
    alt: string;
  };
}

const { size, caption, source, image } = Astro.props;
---
<figure class:list={["case-figure", size]}>
  <div class="case-figure__stage">
    {image ? (
      <img
        class="case-figure__image"
        src={image.asset.src}
        width={image.asset.width}
        height={image.asset.height}
        alt={image.alt}
        loading="lazy"
        decoding="async"
        style={`--image-ratio: ${image.asset.width / image.asset.height}`}
      />
    ) : <slot />}
  </div>
  <figcaption>
    {caption}
    {source && <small>{source}</small>}
  </figcaption>
</figure>

<style>
  .case-figure {
    display: grid;
    grid-template-rows: var(--figure-height) auto;
    min-width: 0;
    margin: 0;
    padding-block: var(--case-figure-spacing);
    --figure-height: clamp(19rem, 44vw, 40rem);
  }
  .medium { --figure-height: clamp(15rem, 27vw, 22rem); }
  .small { --figure-height: clamp(11rem, 21vw, 15rem); }
  .case-figure__stage {
    display: grid;
    place-items: center;
    container-type: size;
    min-width: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    background: var(--case-figure-bg);
  }
  .case-figure__image {
    display: block;
    width: min(100cqw, calc(100cqh * var(--image-ratio)));
    height: auto;
  }
  figcaption {
    min-height: 6rem;
    padding-block: 0.875rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  figcaption small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--case-muted);
  }
  @media (max-width: 640px) {
    .case-figure { --figure-height: clamp(17rem, 82vw, 23rem); }
    .medium { --figure-height: clamp(12rem, 60vw, 19rem); }
    .small { --figure-height: auto; }
    .small .case-figure__stage { container-type: inline-size; }
  }
</style>
