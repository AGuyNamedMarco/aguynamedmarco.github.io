---
interface Props {
  size: "large" | "medium" | "small";
  caption: string;
  source?: string;
  image?: {
    src: string;
    width: number;
    alt: string;
    crop: { x: number; y: number; width: number; height: number };
  };
}

const { size, caption, source, image } = Astro.props;
const crop = image?.crop;
---
<figure class:list={["case-figure", size]}>
  <div class="case-figure__stage">
    {image && crop ? (
      <div class="case-figure__crop" style={`--crop-ratio: ${crop.width} / ${crop.height}`}>
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          style={`width: ${image.width * 100 / crop.width}%; left: ${-crop.x * 100 / crop.width}%; top: ${-crop.y * 100 / crop.height}%`}
        />
      </div>
    ) : <slot />}
  </div>
  <figcaption>
    {caption}
    {source && <small>{source}</small>}
  </figcaption>
</figure>

<style>
  .case-figure {
    display: grid;
    grid-template-rows: var(--figure-height) auto;
    min-width: 0;
    margin: 0;
    --figure-height: clamp(19rem, 44vw, 40rem);
  }
  .medium { --figure-height: clamp(15rem, 27vw, 22rem); }
  .small { --figure-height: clamp(11rem, 21vw, 15rem); }
  .case-figure__stage {
    display: grid;
    place-items: center;
    container-type: size;
    min-width: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    background: var(--case-figure-bg);
  }
  .case-figure__crop {
    position: relative;
    overflow: hidden;
    width: min(100cqw, calc(100cqh * var(--crop-ratio)));
    aspect-ratio: var(--crop-ratio);
  }
  .case-figure__crop img {
    position: absolute;
    display: block;
    max-width: none;
    height: auto;
  }
  figcaption {
    min-height: 6rem;
    padding-block: 0.875rem 1.25rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  figcaption small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--case-muted);
  }
  @media (max-width: 640px) {
    .case-figure { --figure-height: clamp(17rem, 82vw, 23rem); }
    .medium { --figure-height: clamp(12rem, 60vw, 19rem); }
    .small { --figure-height: auto; }
    .small .case-figure__stage { container-type: inline-size; }
  }
</style>
