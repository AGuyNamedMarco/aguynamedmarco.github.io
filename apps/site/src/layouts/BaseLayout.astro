---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "UI/UX portfolio featuring case studies and shipped product work.",
  currentPath = "/"
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="fern">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&family=Syne:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content" class="container">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const KEY = "portfolio-theme";
        const root = document.documentElement;
        const toggle = document.getElementById("theme-toggle");
        const validThemes = ["fern", "nocturne"];

        const applyTheme = (theme) => {
          const next = validThemes.includes(theme) ? theme : "fern";
          root.setAttribute("data-theme", next);
          if (toggle instanceof HTMLButtonElement) {
            const isNocturne = next === "nocturne";
            toggle.textContent = isNocturne ? "Theme: Nocturne" : "Theme: Fern";
            toggle.setAttribute("aria-pressed", String(isNocturne));
          }
        };

        const storedTheme = localStorage.getItem(KEY);
        applyTheme(storedTheme || "fern");

        if (toggle instanceof HTMLButtonElement) {
          toggle.addEventListener("click", () => {
            const current = root.getAttribute("data-theme") || "fern";
            const next = current === "fern" ? "nocturne" : "fern";
            localStorage.setItem(KEY, next);
            applyTheme(next);
          });
        }
      })();
    </script>
  </body>
</html>
