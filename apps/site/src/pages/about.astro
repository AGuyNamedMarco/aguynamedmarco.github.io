---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="About | Marco Chen"
  description="About Marco Chen, a UI/UX designer focused on accessible and evidence-driven product decisions."
  currentPath="/about"
>
  <section class="card" aria-labelledby="about-title">
    <h1 id="about-title">About</h1>
    <p>
      I am a product designer who translates complex workflows into clear and inclusive digital experiences.
      My process combines qualitative research, interaction design, and close engineering collaboration.
    </p>
    <h2>Design Principles</h2>
    <ul>
      <li>Design from user evidence, not assumptions.</li>
      <li>Prioritize accessibility as a baseline quality bar.</li>
      <li>Measure outcomes and iterate quickly.</li>
    </ul>
  </section>
</BaseLayout>