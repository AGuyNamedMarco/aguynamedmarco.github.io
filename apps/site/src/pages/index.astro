    secondary: "Review capabilities",
    details: ["Health", "Mobility", "Nonprofit"]
  },
  {
    slug: "dashboard",
    label: "08 Impact Dashboard",
    eyebrow: "Metrics-forward and outcome-oriented",
    title: "Design that moves teams and numbers forward.",
