---
<BaseLayout
  title="Marco Mendoza | Product & UX Designer"
  description="UI/UX portfolio featuring product case studies, process, and measurable outcomes."
  currentPath="/"
>
  <section class="hero-lab-intro" aria-labelledby="home-title">
    <div>
      <Badge label="Hero Explorations" />
      <h1 id="home-title">20 hero directions for &quot;Let&apos;s build something great together.&quot;</h1>
    </div>
    <p>
      Each concept explores a different mood, layout system, and level of visual intensity so you can compare
      approaches directly in the browser.
    </p>
  </section>

  <section class="hero-lab" aria-labelledby="hero-lab-title">
    <div class="hero-lab-header">
      <p class="meta">Creative direction set</p>
      <h2 id="hero-lab-title">Choose the energy that fits the story you want the homepage to tell.</h2>
    </div>

    <div class="hero-collection">
      {
        heroStudies.map((hero) => (
          <article class:list={["hero-variant", `hero-${hero.slug}`]} aria-label={hero.label}>
            <div class="hero-copy">
              <div class="hero-copy-top">
                <Badge label={hero.label} />
                <p class="hero-eyebrow">{hero.eyebrow}</p>
              </div>
              <h3>{hero.title}</h3>
              <p class="hero-body">{hero.body}</p>
              <div class="hero-detail-row" aria-label={`${hero.label} focus areas`}>
                {hero.details.map((detail) => (
                  <span>{detail}</span>
                ))}
              </div>
              <div class="hero-actions">
                <Button href="#featured-rail-title">{hero.cta}</Button>
                <Button href="#project-highlights" variant="secondary">
                  {hero.secondary}
                </Button>
              </div>
            </div>

            <div class="hero-visual" aria-hidden="true">
              <div class="hero-visual-panel panel-a">
                <span class="panel-label">North Star</span>
                <strong>Shared ambition</strong>
              </div>
              <div class="hero-visual-panel panel-b">
                <span class="panel-label">Build Loop</span>
                <strong>Plan. Design. Refine. Launch.</strong>
              </div>
              <div class="hero-visual-panel panel-c">
                <span class="panel-label">Signals</span>
                <strong>Team alignment, confident craft, measurable momentum.</strong>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="hero-lab hero-lab-avant" aria-labelledby="hero-lab-avant-title">
    <div class="hero-lab-header">
      <p class="meta">Artistic and human direction set</p>
      <h2 id="hero-lab-avant-title">
        Ten more concepts using the exact headline, with more collaboration, exploration, and problem-solving energy.
      </h2>
    </div>

    <div class="hero-collection hero-collection-avant">
      {
        artisticHeroStudies.map((hero) => (
          <article class:list={["hero-variant", "hero-avant", `hero-${hero.slug}`]} aria-label={hero.label}>
            <div class="hero-copy">
              <div class="hero-copy-top">
                <Badge label={hero.label} />
                <p class="hero-eyebrow">{hero.eyebrow}</p>
              </div>
              <h3>{hero.title}</h3>
              <p class="hero-body">{hero.body}</p>
              <div class="hero-detail-row" aria-label={`${hero.label} focus areas`}>
                {hero.details.map((detail) => (
                  <span>{detail}</span>
                ))}
              </div>
              <div class="hero-actions">
                <Button href="#featured-rail-title">{hero.cta}</Button>
                <Button href="#project-highlights" variant="secondary">
                  {hero.secondary}
                </Button>
              </div>
            </div>

            <div class="hero-visual" aria-hidden="true">
              <div class="hero-visual-panel panel-a">
                <span class="panel-label">Collaboration</span>
                <strong>Ideas move farther when we build them together.</strong>
              </div>
              <div class="hero-visual-panel panel-b">
                <span class="panel-label">Exploration</span>
                <strong>Sketch the unknown. Test the route. Learn out loud.</strong>
              </div>
              <div class="hero-visual-panel panel-c">
                <span class="panel-label">Problem Solving</span>
                <strong>Turn complexity into something clear, useful, and human.</strong>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="featured-rail-title">
    <h2 id="featured-rail-title">Featured Work</h2>
    <FeatureCardRail
      heading="Case Studies"
      railId="home-feature-cards"
      cardSize="lg"
      items={mockFeatureCards}
    />
  </section>

  <section class="section" aria-labelledby="project-highlights">
    <h2 id="project-highlights">Additional Project Highlights</h2>
    <div class="layout-grid">
      {
        projectHighlights.map((project) => (
          <div class="grid-span-6">
            <Card
              eyebrow={project.type}
              title={project.title}
              body={project.description}
              href={project.href}
              linkLabel="Read summary"
            />
          </div>
        ))
      }
    </div>
  </section>
  <section class="section" aria-labelledby="work-history">
    <h2 id="work-history">Work History</h2>
    <div class="layout-grid"></div>
  </section>
  <section class="section" aria-labelledby="about-me">
    <h2 id="about-me">About Me</h2>
    <div class="layout-grid"></div>
  </section>
</BaseLayout>
