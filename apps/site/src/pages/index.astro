---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectHighlights } from "../data/projects";
import Badge from "@portfolio/ui/components/Badge.astro";
import Button from "@portfolio/ui/components/Button.astro";
import Card from "@portfolio/ui/components/Card.astro";
import FeatureCardRail from "@portfolio/ui/components/FeatureCardRail.astro";

const hero = {
  label: "Problem-Solving Lab",
  eyebrow: "Avant-garde type meets experimental systems thinking",
  title: "Let's build something great together.",
  body:
    "A sharp, poster-like concept that celebrates iteration and invention. It is bold enough to feel memorable while still speaking directly to teamwork.",
  cta: "Prototype the next move",
  secondary: "Review the outcomes",
  details: ["Questions", "Experiments", "Resolved complexity"]
};

const mockFeatureCards = [
  { title: "USAspending.gov Search", subtitle: "Designing a search and analysis experience for one of the largest public spending datasets in the United States.", imageUrl: "https://raw.githubusercontent.com/AGuyNamedMarco/aguynamedmarco.github.io/main/assets/figma-exports/USA%20Spending%20Search_final.png", icon: "US", href: "/work/usaspending-search" },
  { title: "Wellness Spots", subtitle: "Find calm spaces, classes, and recovery-focused experiences.", imageUrl: "https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1200&q=80", icon: "WS", href: "#" },
  { title: "Food Trails", subtitle: "Taste chef-driven picks and neighborhood favorites worth the wait.", imageUrl: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1200&q=80", icon: "FT", href: "#" },
  { title: "Night Views", subtitle: "Catch skyline moments and after-dark routes with the best vantage points.", imageUrl: "https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=1200&q=80", icon: "NV", href: "#" },
  { title: "Art Routes", subtitle: "Tour galleries, murals, and contemporary exhibits across the city.", imageUrl: "https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?auto=format&fit=crop&w=1200&q=80", icon: "AR", href: "#" }
];
---
<BaseLayout
  title="Marco Mendoza | Product & UX Designer"
  description="UI/UX portfolio featuring product case studies, process, and measurable outcomes."
  currentPath="/"
>
  <section class="hero-lab hero-lab-avant" aria-labelledby="home-title">
    <div class="hero-collection hero-collection-avant">
      <article class="hero-variant hero-avant hero-problemlab" aria-label={hero.label}>
        <div class="hero-copy">
          <div class="hero-copy-top">
            <Badge label={hero.label} />
            <p class="hero-eyebrow">{hero.eyebrow}</p>
          </div>
          <h1 id="home-title">{hero.title}</h1>
          <p class="hero-body">{hero.body}</p>
          <div class="hero-detail-row" aria-label="Focus areas">
            {hero.details.map((detail) => <span>{detail}</span>)}
          </div>
          <div class="hero-actions">
            <Button href="#featured-rail-title">{hero.cta}</Button>
            <Button href="#project-highlights" variant="secondary">{hero.secondary}</Button>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-visual-panel panel-a">
            <span class="panel-label">Collaboration</span>
            <strong>Ideas move farther when we build them together.</strong>
          </div>
          <div class="hero-visual-panel panel-b">
            <span class="panel-label">Exploration</span>
            <strong>Sketch the unknown. Test the route. Learn out loud.</strong>
          </div>
          <div class="hero-visual-panel panel-c">
            <span class="panel-label">Problem Solving</span>
            <strong>Turn complexity into something clear, useful, and human.</strong>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-rail-title">
    <h2 id="featured-rail-title">Featured Work</h2>
    <FeatureCardRail heading="Case Studies" railId="home-feature-cards" cardSize="lg" items={mockFeatureCards} />
  </section>

  <section class="section" aria-labelledby="project-highlights">
    <h2 id="project-highlights">Additional Project Highlights</h2>
    <div class="layout-grid">
      {projectHighlights.map((project) => (
        <div class="grid-span-6">
          <Card eyebrow={project.type} title={project.title} body={project.description} href={project.href} linkLabel="Read summary" />
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="work-history">
    <h2 id="work-history">Work History</h2>
    <div class="layout-grid"></div>
  </section>

  <section class="section" aria-labelledby="about-me">
    <h2 id="about-me">About Me</h2>
    <div class="layout-grid"></div>
  </section>
</BaseLayout>
