const mockFeatureCards = [
  {
    title: "City Guides",
    subtitle: "Explore neighborhoods with local insight and practical walking routes.",
    imageUrl:
      "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=1200&q=80",
    icon: "CG",
    href: "#"
  },
  {
    title: "Wellness Spots",
    subtitle: "Find calm spaces, classes, and recovery-focused experiences.",
    imageUrl:
      "https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1200&q=80",
    icon: "WS",
    href: "#"
  },
  {
    title: "Food Trails",
    subtitle: "Taste chef-driven picks and neighborhood favorites worth the wait.",
    imageUrl:
      "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1200&q=80",
    icon: "FT",
    href: "#"
  },
  {
    title: "Night Views",
    subtitle: "Catch skyline moments and after-dark routes with the best vantage points.",
    imageUrl:
      "https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=1200&q=80",
    icon: "NV",
