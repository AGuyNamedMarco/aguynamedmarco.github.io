    <ul>
      <li>Email: <a href="mailto:marco@example.com">marco@example.com</a></li>
      <li>LinkedIn: <a href="https://www.linkedin.com" rel="noreferrer">linkedin.com/in/your-profile</a></li>
      <li>Resume: <a href="#">Download resume (PDF)</a></li>
    </ul>
  </section>
</BaseLayout>