{
  "name": "portfolio-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @portfolio/site",
    "build": "npm run build -w @portfolio/site",
    "preview": "npm run preview -w @portfolio/site",
    "check": "npm run check -w @portfolio/site",
    "storybook": "npm run storybook -w @portfolio/ui",
    "build:storybook": "npm run build-storybook -w @portfolio/ui"
  }
}